# Copy to .env.local. The site builds and runs with NONE of these set.

# --- Clerk (accounts; required only for hosted chat) ---
# Create an app at https://dashboard.clerk.com and paste the keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Hosted chat (Anthropic Messages API) ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Site ---
# Public URL of this site (used for sitemap, canonical URLs, download links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# STARS landing page; /donate redirects to `${NEXT_PUBLIC_LANDING_URL}/donate`
NEXT_PUBLIC_LANDING_URL=https://starsportal.org

# --- Chat limits (optional) ---
CHAT_RATE_LIMIT_MAX=20          # messages per window per user
CHAT_RATE_LIMIT_WINDOW_SEC=600  # window length in seconds
